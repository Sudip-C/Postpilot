{
  "name": "postpilot",
  "version": "1.0.0",
  "description": "Autonomous AI-powered LinkedIn content generation and publishing with NVIDIA Nemotron, Supabase, LinkedIn OAuth, Vercel, and GitHub Actions.",
  "main": "index.js",
  "scripts": {
    "test:nvidia": "node scripts/test-nvidia.js",
    "test:gemini": "node scripts/test-gemini.js",
    "test:prompt": "node scripts/test-linkedin-prompt.js",
    "test:generator": "node scripts/test-post-generator.js",
    "test:pillars": "node scripts/test-content-pillars.js",
    "test:post-types": "node scripts/test-post-types.js",
    "test:selector": "node scripts/test-content-selector.js",
    "test:supabase": "node scripts/test-supabase.js",
    "test:posts-table": "node scripts/test-posts-table.js",
    "test:save-post": "node scripts/test-save-post.js",
    "test:recent-posts": "node scripts/test-recent-posts.js",
    "test:linkedin-token": "node scripts/test-linkedin-token-storage.js",
    "test:linkedin-api": "node scripts/test-linkedin-api.js",
    "test:linkedin-publish": "node scripts/test-linkedin-publish.js",
    "test:validator": "node scripts/test-post-validator.js",
    "daily-post": "node scripts/run-daily-post.js",
    "test:retry": "node scripts/test-retry.js",
